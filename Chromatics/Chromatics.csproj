<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <StartupObject>Chromatics.Program</StartupObject>
    <Version>4.1.38.0</Version>
    <Authors>Danielle Thompson</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Copyright>logicallysynced 2026</Copyright>
    <PackageProjectUrl>https://chromaticsffxiv.com</PackageProjectUrl>
    <NeutralLanguage>en-AU</NeutralLanguage>
    <ApplicationIcon>Resources\Chromatics_icon_144x144.ico</ApplicationIcon>
    <PackageReleaseNotes>https://github.com/roxaskeyheart/chromatics/releases</PackageReleaseNotes>
    <Title>Chromatics</Title>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="locale\**" />
    <EmbeddedResource Remove="locale\**" />
    <None Remove="locale\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="locale\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Chromatics_icon_144x144.ico" />
    <AvaloniaResource Include="Resources\Chromatics_icon_128x128.png" />
    <AvaloniaResource Include="Resources\logo.png" />
    <AvaloniaResource Include="Resources\chromatics_white.png" />
    <AvaloniaResource Include="Resources\notification.png" />
    <AvaloniaResource Include="Resources\sword.png" />
    <AvaloniaResource Include="Resources\keyboard.png" />
    <AvaloniaResource Include="Resources\cloudy.png" />
    <AvaloniaResource Include="Resources\crystal.png" />
    <AvaloniaResource Include="Resources\video-clip.png" />
    <AvaloniaResource Include="Resources\coin.png" />
    <AvaloniaResource Include="Resources\raid.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.3" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.0-a3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="Sentry" Version="6.5.0" />
    <PackageReference Include="Sentry.Profiling" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="HueApi" Version="3.2.0" />
    <PackageReference Include="HueApi.ColorConverters" Version="3.1.0" />
    <PackageReference Include="HueApi.Entertainment" Version="3.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.1.3" />
    <PackageReference Include="RGB.NET.Core" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Asus" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.CoolerMaster" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Corsair" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Logitech" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Msi" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Novation" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.OpenRGB" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Razer" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.SteelSeries" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Devices.Wooting" Version="3.2.0" />
    <PackageReference Include="RGB.NET.HID" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Layout" Version="3.2.0" />
    <PackageReference Include="RGB.NET.Presets" Version="3.2.0" />
    <PackageReference Include="Sharlayan" Version="9.0.34" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Interop.AuraServiceLib">
      <HintPath>..\Build Dependencies\Interop.AuraServiceLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>