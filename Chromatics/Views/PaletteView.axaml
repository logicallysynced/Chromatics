<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Chromatics.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="Chromatics.Views.PaletteView"
             x:DataType="vm:PaletteViewModel">

    <Grid ColumnDefinitions="*,16,420" Margin="16">

        <!-- Left: filter + grid + buttons -->
        <Grid Grid.Column="0" RowDefinitions="Auto,8,*,8,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Filter:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          MinWidth="220" />
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"     Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="180" />
                        <!-- Right margin keeps the swatch clear of the 14px vertical scrollbar. -->
                        <DataGridTemplateColumn Header="Color" Width="90" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="vm:PaletteMappingItem">
                                    <Border Background="{Binding Brush}"
                                            CornerRadius="4"
                                            BorderBrush="#33000000"
                                            BorderThickness="1"
                                            Margin="6,4,18,4" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                <Button Content="Import"
                        Command="{Binding ImportCommand}"
                        ToolTip.Tip="Import Chromatics color palette from file" />
                <Button Content="Export"
                        Command="{Binding ExportCommand}"
                        ToolTip.Tip="Export Chromatics color palette to file" />
                <Button Content="Restore Default"
                        Command="{Binding UndoCommand}"
                        ToolTip.Tip="Restore selected color mapping to its default" />
            </StackPanel>
        </Grid>

        <!-- Right: editor + preview -->
        <Border Grid.Column="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid RowDefinitions="Auto,8,Auto,8,*">

                <TextBlock Grid.Row="0"
                           Text="{Binding SelectedItem.DisplayName, FallbackValue='Select a mapping to edit'}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <Border Grid.Row="2"
                        Height="40"
                        CornerRadius="4"
                        BorderBrush="#33000000"
                        BorderThickness="1"
                        Background="{Binding SelectedItem.Brush, FallbackValue=Transparent}" />

                <!-- Color picker with placeholder overlay when nothing selected -->
                <Panel Grid.Row="4">
                    <ColorView Color="{Binding EditorColor, Mode=TwoWay}"
                               IsEnabled="{Binding EditorEnabled}"
                               IsAlphaEnabled="False"
                               IsAlphaVisible="False" />

                    <!-- Overlay shown when editor is disabled -->
                    <Border Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
                            CornerRadius="4"
                            Opacity="0.55"
                            IsVisible="{Binding !EditorEnabled}" />
                    <TextBlock Text="Select a color mapping&#10;from the list to edit"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Opacity="0.6"
                               IsVisible="{Binding !EditorEnabled}" />
                </Panel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
