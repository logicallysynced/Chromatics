<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Chromatics.Localization"
        x:Class="Chromatics.Views.CrashFeedbackDialog"
        Title="{loc:Tr Key='Chromatics has crashed'}"
        Width="540" Height="520"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True"
        Topmost="True"
        Icon="avares://Chromatics/Resources/Chromatics_icon_128x128.png">
    <Grid RowDefinitions="Auto,*">
        <!-- Branded header bar matching the main Chromatics window -->
        <Border Grid.Row="0"
                Background="{DynamicResource ChromaticsBanner}"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Image Source="avares://Chromatics/Resources/Chromatics_icon_128x128.png"
                       Width="36" Height="36"
                       VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Chromatics"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Tr Key='Chromatics has crashed'}"
                               FontSize="12"
                               Opacity="0.75" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="20,16,20,16">
            <TextBlock Grid.Row="0"
                       Text="{loc:Tr Key='Chromatics has encountered an unexpected error and needs to close.'}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="1"
                       Text="{loc:Tr Key='You can help us fix this by sending a crash report. No personally identifying information is collected. Adding a short description of what you were doing makes it much easier to reproduce.'}"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,8,0,12" />

            <TextBlock Grid.Row="2"
                       Text="{loc:Tr Key='What were you doing when this happened? (optional)'}"
                       Margin="0,4,0,4" />

            <TextBox Grid.Row="3"
                     Name="CommentsBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="120"
                     VerticalContentAlignment="Top" />

            <SelectableTextBlock Grid.Row="4"
                                 Name="ErrorSummary"
                                 FontFamily="Consolas, monospace"
                                 FontSize="11"
                                 Opacity="0.55"
                                 TextWrapping="NoWrap"
                                 Margin="0,12,0,0" />

            <Border Grid.Row="5"
                    Margin="0,10,0,0"
                    Padding="10,8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ChromaticsAccent}"
                    CornerRadius="4">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{loc:Tr Key='Reference ID:'}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <SelectableTextBlock Grid.Column="1"
                                         Name="ReferenceIdText"
                                         FontFamily="Consolas, monospace"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         TextWrapping="NoWrap" />
                    <Button Grid.Column="2"
                            Name="CopyReferenceButton"
                            Content="{loc:Tr Key='Copy'}"
                            Padding="10,4"
                            FontSize="11"
                            Click="OnCopyReference" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,16,0,0">
                <Button Name="DontSendButton"
                        Content="{loc:Tr Key=&quot;Don&apos;t Send&quot;}"
                        Width="120"
                        Click="OnDontSend" />
                <Button Name="SendButton"
                        Content="{loc:Tr Key='Send Report'}"
                        Width="140"
                        Classes="accent"
                        Click="OnSend" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
