<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Chromatics.Localization"
        xmlns:vm="clr-namespace:Chromatics.ViewModels"
        x:Class="Chromatics.Views.NanoleafAdoptionDialog"
        x:DataType="vm:NanoleafAdoptionDialogViewModel"
        Title="{loc:Tr Key='Pair Nanoleaf controllers'}"
        Width="580" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20">

        <TextBlock Grid.Row="0"
                   Text="{loc:Tr Key='Pair each Nanoleaf controller Chromatics should control. Pairing a controller needs a physical button press - the dialog will tell you when.'}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ProgressBar Grid.Column="1"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="80" Height="8"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Controllers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Opacity="0.7" FontSize="11"
                                                   Text="{Binding SubText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="{Binding ActionLabel}"
                                            IsEnabled="{Binding ActionEnabled}"
                                            Command="{Binding ActionCommand}"
                                            MinWidth="96"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBox Grid.Column="0"
                     PlaceholderText="{loc:Tr Key='Controller IP address (if not found automatically)'}"
                     Text="{Binding ManualIp, Mode=TwoWay}"
                     Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    Content="{loc:Tr Key='Add by IP'}"
                    Command="{Binding AddByIpCommand}"
                    MinWidth="110" />
        </Grid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Name="DiscoverAgainButton"
                    Content="{loc:Tr Key='Search again'}"
                    Click="OnDiscoverAgain"
                    MinWidth="120" />
            <Button Name="CancelButton"
                    Content="{loc:Tr Key=Cancel}"
                    Click="OnCancel"
                    MinWidth="100" />
            <Button Name="SaveButton"
                    Content="{loc:Tr Key=Save}"
                    Classes="accent"
                    Click="OnSave"
                    MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
