<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Chromatics.Localization"
        xmlns:hue="clr-namespace:Chromatics.Extensions.RGB.NET.Devices.Hue"
        x:Class="Chromatics.Views.HueBridgeDialog"
        Title="{loc:Tr Key='Hue Bridge'}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="20">

        <TextBlock Grid.Row="0"
                   Text="{loc:Tr Key='Choose a Hue bridge to connect to.'}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <!-- Auto-discovery banner -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Name="DiscoveryStatusText"
                           VerticalAlignment="Center"
                           Text="{loc:Tr Key='Searching your network for Hue bridges...'}" />
                <ProgressBar Name="DiscoveryProgress"
                             IsIndeterminate="True"
                             Width="80" Height="8"
                             VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Discovered bridges list -->
        <Border Grid.Row="2"
                Name="DiscoveredBridgesPanel"
                BorderThickness="1"
                CornerRadius="4"
                MinHeight="80"
                MaxHeight="160"
                Margin="0,0,0,12"
                IsVisible="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="DiscoveredBridgesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="hue:HueBridgeDiscovery+DiscoveredBridge">
                            <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InternalIp}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Id}" Opacity="0.6" FontSize="11" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{loc:Tr Key='Use this bridge'}"
                                            Tag="{Binding InternalIp}"
                                            Click="OnUseDiscoveredBridge"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Manual entry -->
        <TextBlock Grid.Row="3"
                   Text="{loc:Tr Key='Or enter the bridge IP manually:'}"
                   Margin="0,0,0,4"
                   Opacity="0.85" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{loc:Tr Key='Bridge IP:'}" Width="80" VerticalAlignment="Center" />
            <TextBox Name="IpText" Width="240" />
        </StackPanel>

        <!-- Pairing instruction -->
        <TextBlock Grid.Row="5"
                   Text="{loc:Tr Key='Press the button on the Hue bridge BEFORE clicking Submit.'}"
                   TextWrapping="Wrap"
                   FontStyle="Italic"
                   Opacity="0.8"
                   Margin="0,0,0,8" />

        <!-- Status / error line -->
        <TextBlock Grid.Row="6"
                   Name="StatusText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlHighlightAltListAccentHighBrush}" />

        <!-- Buttons -->
        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="CancelButton"
                    Content="{loc:Tr Key=Cancel}"
                    Width="100"
                    Click="OnCancel" />
            <Button Name="SubmitButton"
                    Content="{loc:Tr Key=Submit}"
                    Width="100"
                    Classes="accent"
                    Click="OnSubmit" />
        </StackPanel>
    </Grid>
</Window>
