<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Chromatics.Localization"
        x:Class="Chromatics.Views.Dialogs.FirstRunDialog"
        Title="{loc:Tr Key='Welcome to Chromatics'}"
        Width="760" Height="540"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="True"
        Icon="avares://Chromatics/Resources/Chromatics_icon_128x128.png">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="28">

        <!-- Header row: title on the left, language picker on the right.
             The picker writes to settings + LocalizationService on selection
             so the rest of the dialog re-renders in the chosen language live. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0"
                       Text="{loc:Tr Key='Welcome to Chromatics'}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      Name="LanguageBox"
                      MinWidth="180"
                      VerticalAlignment="Center"
                      SelectionChanged="OnLanguageChanged" />
        </Grid>

        <!-- Subtitle / instructions -->
        <TextBlock Grid.Row="1"
                   Text="{loc:Tr Key='To get started, select the device providers you wish to use. You can change these at any time from the Settings menu.'}"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Opacity="0.7"
                   Margin="0,0,0,20" />

        <!-- Provider tile grid. Layout mirrors Settings → Device Providers. -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ToggleButton Classes="tile" Name="TileRazer"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=Razer}" />
                <ToggleButton Classes="tile" Name="TileLogitech"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=Logitech}" />
                <ToggleButton Classes="tile" Name="TileCorsair"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=Corsair}" />
                <ToggleButton Classes="tile" Name="TileCoolermaster"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=Coolermaster}" />
                <ToggleButton Classes="tile" Name="TileSteelSeries"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=SteelSeries}" />
                <ToggleButton Classes="tile" Name="TileAsus"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=ASUS}" />
                <ToggleButton Classes="tile" Name="TileMsi"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=MSI}" />
                <ToggleButton Classes="tile" Name="TileWooting"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=Wooting}" />
                <ToggleButton Classes="tile" Name="TileNovation"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=Novation}" />
                <ToggleButton Classes="tile" Name="TileOpenRgb"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=OpenRGB}" />
                <ToggleButton Classes="tile" Name="TilePlayStation"
                              Width="150" Height="80"
                              Content="{loc:Tr Key=PlayStation}" />
                <ToggleButton Classes="tile" Name="TileQmkRawHid"
                              Width="150" Height="80"
                              ToolTip.Tip="{loc:Tr Key='QMK keyboards over Raw HID. Covers NovelKeys, KBDFans, Drop, GMMK, Glorious and any other custom keyboard running QMK with Raw HID enabled.'}"
                              Content="{loc:Tr Key='QMK Keyboards (Beta)'}" />
                <ToggleButton Classes="tile" Name="TileHue"
                              Width="150" Height="80"
                              ToolTip.Tip="{loc:Tr Key='Philips Hue smart bulbs over your local Hue Bridge.'}"
                              Content="{loc:Tr Key=Hue}" />
                <ToggleButton Classes="tile" Name="TileLifx"
                              Width="150" Height="80"
                              ToolTip.Tip="{loc:Tr Key='LIFX bulbs, strips and tiles on your local network. No cloud account required.'}"
                              Content="{loc:Tr Key=LIFX}" />
                <ToggleButton Classes="tile" Name="TileYeelight"
                              Width="150" Height="80"
                              ToolTip.Tip="{loc:Tr Key='Yeelight bulbs, light strips and lamps on your local network. Requires LAN Control enabled in the Yeelight or Mi Home app.'}"
                              Content="{loc:Tr Key='Yeelight (Beta)'}" />
                <ToggleButton Classes="tile" Name="TileAlienware"
                              Width="150" Height="80"
                              ToolTip.Tip="{loc:Tr Key='Alienware AlienFX hardware (chassis, notebook keyboards, external keyboards). Close Alienware Command Center first - it holds the AlienFX HID interface exclusively.'}"
                              Content="{loc:Tr Key='Alienware (Beta)'}" />
                <ToggleButton Classes="tile" Name="TileDynamicLighting"
                              Width="150" Height="80"
                              ToolTip.Tip="{loc:Tr Key='Windows Dynamic Lighting picks up any device Windows lists in Settings -> Personalization -> Dynamic Lighting. Requires Windows 11. Covers Razer, Logitech G LIGHTSYNC, ASUS ROG, HyperX, MSI, SteelSeries, HP and Omen hardware.'}">
                    <!-- Explicit TextBlock instead of string Content so the
                         label wraps inside the 150px-wide tile. ContentPresenter
                         creates an implicit TextBlock for string content but
                         it isn't a logical-tree descendant of the ToggleButton,
                         so the global ToggleButton.tile TextBlock wrap style
                         in App.axaml doesn't reach it. -->
                    <TextBlock Text="{loc:Tr Key='Windows Dynamic Lighting (Beta)'}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="130" />
                </ToggleButton>
            </WrapPanel>
        </ScrollViewer>

        <!-- Validation hint -->
        <TextBlock Grid.Row="4"
                   Name="HintText"
                   Text="{loc:Tr Key='Please select at least one device provider to continue.'}"
                   Opacity="0.6"
                   FontStyle="Italic"
                   IsVisible="True"
                   Margin="0,12,0,0" />

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Spacing="10">
            <Button Content="{loc:Tr Key='Exit Chromatics'}"
                    MinWidth="130"
                    Click="OnExit" />
            <Button Name="BtnContinue"
                    Content="{loc:Tr Key=Continue}"
                    Classes="accent"
                    MinWidth="130"
                    IsEnabled="False"
                    Click="OnContinue" />
        </StackPanel>
    </Grid>
</Window>
