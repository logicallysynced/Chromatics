<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Chromatics.Localization"
        x:Class="Chromatics.Views.Dialogs.InfoDialog"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <TextBlock Grid.Row="0"
                   Name="TitleText"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <TextBlock Grid.Row="1"
                   Name="MessageText"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Margin="0,0,0,20" />
        <Button Grid.Row="2"
                Name="OkButton"
                Content="{loc:Tr Key=OK}"
                MinWidth="96"
                HorizontalAlignment="Right"
                Classes="accent"
                Click="OnOk" />
    </Grid>
</Window>
