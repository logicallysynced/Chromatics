<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Chromatics.Localization"
        xmlns:vm="clr-namespace:Chromatics.ViewModels"
        x:Class="Chromatics.Views.Dialogs.CopyLayersDialog"
        x:DataType="vm:CopyLayersDialogViewModel"
        Title="{loc:Tr Key='Copy layers between devices'}"
        Width="720" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="24">

        <TextBlock Grid.Row="0"
                   Text="{loc:Tr Key='Copy layers between devices'}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />

        <TextBlock Grid.Row="1"
                   Text="{loc:Tr Key='Duplicate every layer on the source device onto the destination device. Original layers on the source are left untouched. Keyboards can only copy to other keyboards; everything else can cross device types.'}"
                   TextWrapping="Wrap"
                   Opacity="0.8"
                   Margin="0,0,0,16" />

        <!-- Source row -->
        <Grid Grid.Row="2" ColumnDefinitions="120,*" Margin="0,0,0,8">
            <TextBlock Grid.Column="0"
                       Text="{loc:Tr Key='Source device'}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Name}"
                      HorizontalAlignment="Stretch" />
        </Grid>

        <!-- Arrow + destination row -->
        <Grid Grid.Row="3" ColumnDefinitions="120,*" Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold">
                <Run Text="&#x2193;"
                     FontSize="20" />
                <Run Text=" " />
                <Run Text="{loc:Tr Key='Destination'}" />
            </TextBlock>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AvailableDestinations}"
                      SelectedItem="{Binding SelectedDestination, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Name}"
                      HorizontalAlignment="Stretch" />
        </Grid>

        <!-- Mapping table header -->
        <Grid Grid.Row="4" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,40,*" Margin="0,0,0,4">
                <TextBlock Grid.Column="0"
                           Text="{loc:Tr Key='Source LED'}"
                           FontWeight="SemiBold"
                           Margin="6,0" />
                <TextBlock Grid.Column="2"
                           Text="{loc:Tr Key='Destination LED'}"
                           FontWeight="SemiBold"
                           Margin="6,0" />
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Mappings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,40,*" Margin="6,3">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SourceLedIdLabel}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="&#x2192;"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.6" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding $parent[Window].((vm:CopyLayersDialogViewModel)DataContext).AvailableDestLedIds}"
                                              SelectedItem="{Binding DestinationLedId, Mode=TwoWay}"
                                              IsEnabled="{Binding HasDestination, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Summary -->
        <TextBlock Grid.Row="5"
                   Text="{Binding SummaryText}"
                   Margin="0,12,0,0"
                   FontStyle="Italic"
                   Opacity="0.8"
                   TextWrapping="Wrap" />

        <!-- Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Name="CancelButton"
                    Content="{loc:Tr Key=Cancel}"
                    Click="OnCancel"
                    MinWidth="100" />
            <Button Name="CopyButton"
                    Content="{loc:Tr Key='Copy layers'}"
                    Click="OnCopy"
                    Classes="accent"
                    MinWidth="120" />
        </StackPanel>
    </Grid>
</Window>
