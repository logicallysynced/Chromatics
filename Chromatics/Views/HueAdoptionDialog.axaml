<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Chromatics.Localization"
        xmlns:vm="clr-namespace:Chromatics.ViewModels"
        x:Class="Chromatics.Views.HueAdoptionDialog"
        x:DataType="vm:HueAdoptionDialogViewModel"
        Title="{loc:Tr Key='Choose Hue lights'}"
        Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">

        <TextBlock Grid.Row="0"
                   Text="{loc:Tr Key='Select which Hue lights Chromatics should control. You can change this later from Settings.'}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ProgressBar Grid.Column="1"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}"
                             Width="80" Height="8"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderThickness="1"
                CornerRadius="4"
                Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Bulbs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ModelId}"
                                                   Opacity="0.6" FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Name="CancelButton"
                    Content="{loc:Tr Key=Cancel}"
                    Click="OnCancel"
                    MinWidth="100" />
            <Button Name="SaveButton"
                    Content="{loc:Tr Key=Save}"
                    Classes="accent"
                    Click="OnSave"
                    MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
